# Names only — copy to .env.local. Never commit real secrets.
# Same names across Ishaare and Spycy (one Firebase project assumed).

# Canonical origin (server-only), e.g. https://spycy.vercel.app or http://localhost:3000
SITE_URL=

# Firebase Admin — Console → Project settings → Service accounts → Generate new private key
# Never put these in NEXT_PUBLIC_* / client bundles
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# private_key from the JSON; keep \n escapes or paste PEM with real newlines
FIREBASE_PRIVATE_KEY=

# Firebase web config — Console → Project settings → Your apps → Web app (public-by-design; needed for lobby realtime)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional — measurementId if Analytics is enabled
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Stripe Dashboard → Developers → API keys / Webhooks (use sk_test_ / whsec_ for test)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Spycy /admin word-pack editor (server-only — never NEXT_PUBLIC_)
# Set in .env.local and Vercel; open https://<host>/admin and sign in with this password
ADMIN_PASSWORD=
